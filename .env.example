NCBI_EMAIL=your.email@institution.edu
NCBI_API_KEY=your_ncbi_key
SCOPUS_API_KEY=your_elsevier_scopus_key
WOS_API_KEY=

# e-INFRA MetaCentrum LLM endpoint (primary for screening runs)
# Get a token at https://llm.ai.e-infra.cz
E_INFRA_API_TOKEN=

# LLM screening. For e-INFRA MetaCentrum:
# OPENAI_API_KEY=$E_INFRA_API_TOKEN
# OPENAI_BASE_URL=https://llm.ai.e-infra.cz/v1
# OPENAI_MODEL=qwen3.5-122b
#
# For LM Studio (local):
# OPENAI_API_KEY=lm-studio
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=local-model-name
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
